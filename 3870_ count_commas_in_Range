class Solution {
    public int countCommas(int n) {
      int commas = 0; 
      for (int  i = 1;i<=n;i++)
      {
       int temp = i;
       int digit = 0 ; 
       while(temp>0)
       {
        digit ++;
        temp/=10;
       }
       commas = commas + (digit-1)/3;
       
      }return commas;
      
    }
}
